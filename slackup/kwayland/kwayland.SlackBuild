#!/bin/bash

cd $(dirname $0) ; CWD=$(pwd)

PRGNAM=kwayland
VERSION=${VERSION:-5.90.0}
ORIG_BUILD=2
ORIG_TAG=_slack15.0
BUILD=${BUILD:-1}
TAG=${TAG:-_SBo}

ARCH=x86_64

if [ ! -z "${PRINT_PACKAGE_NAME}" ]; then
  echo "$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
  exit 0
fi

OUTPUT=${OUTPUT:-/tmp}

set -eu

mkdir -p $OUTPUT

cat $CWD/$PRGNAM-$VERSION-$ARCH-$ORIG_BUILD$ORIG_TAG.$PKGTYPE > \
  $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE
